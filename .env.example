# How often the pipeline runs (in minutes)
INGEST_INTERVAL_MINUTES=30

# Database connection string (default uses local sqlite)
DB_URL=sqlite:///./jobs.db

# Base delay per source for rate-limiting (seconds)
RATE_LIMIT_BASE_DELAY_SECONDS=3

# Number of minutes before data is considered stale if ingestion fails
STALE_AFTER_MINUTES=120

# Number of consecutive failures before a source is marked as "down"
FAILURE_THRESHOLD=3

# Primary source API URL
REMOTEOK_URL=https://remoteok.com/api

# Fallback source API URL
ARBEITNOW_URL=https://www.arbeitnow.com/api/job-board-api
